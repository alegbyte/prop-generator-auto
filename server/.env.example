# Google Gemini API
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# HeyGen API
# Get your key at: https://app.heygen.com/settings?nav=API
HEYGEN_API_KEY=your_heygen_api_key_here

# HeyGen Avatar & Voice IDs
# Find avatar IDs at: https://docs.heygen.com/reference/list-avatars-v2
# Find voice IDs at: https://docs.heygen.com/reference/list-voices-v2
HEYGEN_AVATAR_ID=your_avatar_id_here
HEYGEN_VOICE_ID=your_voice_id_here

# Short link domain — the public URL where this server is reachable
# For local dev: http://localhost:3001
# For production: https://go.yourdomain.com
SHORT_DOMAIN=http://localhost:3001

# MongoDB connection string
# Local:   mongodb://localhost:27017/proposals_db
# Atlas:   mongodb+srv://user:password@cluster.mongodb.net/proposals_db
MONGODB_URI=mongodb://localhost:27017/proposals_db

# Server port
PORT=3001
